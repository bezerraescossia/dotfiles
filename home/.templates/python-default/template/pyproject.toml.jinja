[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = []

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=6",
    "ruff>=0.14",
    "mypy>=1.14",
    "pre-commit>=4",
    "taskipy>=1.14",
]

[tool.uv]
package = false

[tool.ruff]
target-version = "py{{ python_version.replace('.', '') }}"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.mypy]
python_version = "{{ python_version }}"
files = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.coverage.run]
source = ["src"]

[tool.taskipy.tasks]
test = "pytest"
test-cov = "pytest --cov --cov-report=term-missing"
lint = "ruff check ."
format = "ruff format ."
typecheck = "mypy ."
check = "task lint && task typecheck && task test"
precommit = "pre-commit run --all-files"
